{
  "name": "web-interactive-live",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "concurrently -k -n server,web \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src server e2e playwright.config.ts vite.config.ts README.md",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "patch-package": "^8.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "wordcloud": "1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/wordcloud": "^1.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
